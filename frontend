"script.js": r'''const messageInput = document.getElementById('messageInput');
const charCount = document.getElementById('charCount');
const analyzeButton = document.getElementById('analyzeButton');
const resultCard = document.getElementById('resultCard');
const toast = document.getElementById('toast');
let analyzedCount = 1284;
let flaggedCount = 37;
let toastTimer;

const signals = [
  { key: /\b(kill|hurt|attack|beat you|find you)\b/i, weight: 45, name: 'Possible threatening language', description: 'The text contains language that may be perceived as threatening. Context is needed before drawing a conclusion.' },
  { key: /\b(useless|idiot|stupid|pathetic|hate you|worthless|everyone hates you)\b/i, weight: 35, name: 'Potential insult or degrading language', description: 'The text may contain insulting or degrading language directed at someone.' },
  { key: /\b(keep messaging|new accounts|won.t stop|won't stop|follow you|watching you|reply to me)\b/i, weight: 38, name: 'Possible unwanted-contact signal', description: 'The message may indicate persistent contact. A behavioral model needs message history and consent/context to assess stalking patterns.' },
  { key: /\b(send nudes|explicit photo|private photo)\b/i, weight: 30, name: 'Potential sexual-boundary concern', description: 'The text may involve a sensitive request. Review context and consent; this demo does not analyze images or media.' },
  { key: /\b(damn|hell|crap)\b/i, weight: 8, name: 'Mild profanity signal', description: 'A potentially profane term was found, but profanity alone does not establish harassment.' }
];

function showToast(message) {
  toast.textContent = message;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 2800);
}

messageInput.addEventListener('input', () => {
  charCount.textContent = `${messageInput.value.length} character${messageInput.value.length === 1 ? '' : 's'}`;
});

document.querySelectorAll('.sample-chip').forEach(button => {
  button.addEventListener('click', () => {
    messageInput.value = button.dataset.sample;
    messageInput.dispatchEvent(new Event('input'));
    messageInput.focus();
  });
});

analyzeButton.addEventListener('click', () => {
  const message = messageInput.value.trim();
  if (!message) {
    messageInput.focus();
    showToast('Enter a message first, or choose one of the sample messages.');
    return;
  }

  const matched = signals.filter(signal => signal.key.test(message));
  let score = matched.reduce((total, signal) => total + signal.weight, 0);
  // Repetition terms are only a text hint; actual stalking detection requires message history.
  if (/\b(again|every day|all the time|multiple times|won't stop|wont stop)\b/i.test(message)) score += 12;
  score = Math.min(score, 96);

  const isFlagged = score >= 30;
  const isMedium = score >= 15 && score < 30;
  const title = isFlagged ? 'Potential concern detected' : isMedium ? 'Low-level signal detected' : 'No strong signal found';
  const description = matched.length
    ? matched.map(item => item.description).join(' ')
    : 'The demo rules did not match any configured signal. This does not guarantee that the message is safe; indirect harassment, sarcasm, slang, and context may be missed.';
  document.getElementById('resultTitle').textContent = title;
  document.getElementById('resultDescription').textContent = description;
  document.getElementById('riskScore').textContent = `${score}%`;
  document.getElementById('riskMeter').style.width = `${score}%`;
  document.getElementById('riskMeter').classList.toggle('safe-meter', score < 30);
  const badge = document.getElementById('riskBadge');
  badge.textContent = isFlagged ? 'REVIEW' : isMedium ? 'LOW SIGNAL' : 'NO MATCH';
  badge.classList.toggle('safe', !isFlagged);
  resultCard.classList.remove('hidden');
  analyzedCount++;
  document.getElementById('messagesAnalyzed').textContent = analyzedCount.toLocaleString('en-US');
  if (isFlagged) {
    flaggedCount++;
    document.getElementById('flaggedCount').textContent = flaggedCount.toLocaleString('en-US');
    addIncident(matched[0]?.name || 'Manual review suggested', score >= 40 ? 'High' : 'Medium');
  }
  resultCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
});

function addIncident(signalName, risk) {
  const tbody = document.getElementById('incidentRows');
  const row = document.createElement('tr');
  const id = 1049 + tbody.querySelectorAll('tr').length;
  const riskClass = risk === 'High' ? 'risk-high' : 'risk-medium';
  row.innerHTML = `<td><span class="item-icon">✉</span><span class="item-main">Message #${id}<small>Local demo · just now</small></span></td><td></td><td><span class="${riskClass}">${risk}</span></td><td><span class="status-review">Needs review</span></td>`;
  row.children[1].textContent = signalName;
  tbody.prepend(row);
  while (tbody.children.length > 5) tbody.removeChild(tbody.lastElementChild);
}

document.getElementById('viewAllButton').addEventListener('click', () => {
  showToast('Prototype view: showing the latest sample incidents.');
});

document.getElementById('menuButton').addEventListener('click', () => {
  document.getElementById('sidebar').classList.toggle('open');
});

document.querySelectorAll('.nav-link').forEach(link => {
  link.addEventListener('click', () => {
    document.querySelectorAll('.nav-link').forEach(item => item.classList.remove('active'));
    link.classList.add('active');
    if (window.innerWidth <= 720) document.getElementById('sidebar').classList.remove('open');
  });
});
'''
