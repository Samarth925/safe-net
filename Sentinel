
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sentinel – see harassment before it escalates</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#070b18; --text:#eef2ff; --mut:#9aa6c4; --glass:rgba(255,255,255,.06); --edge:rgba(255,255,255,.13);
  --safe:#34d399; --warn:#fbbf24; --danger:#fb4b63; --lv:var(--safe);
  --serif:'Fraunces',Georgia,serif; --sans:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
}
body.lvl-warn{--lv:var(--warn)} body.lvl-danger{--lv:var(--danger)}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--text);font:15px/1.45 var(--sans);padding:22px;min-height:100vh;position:relative;overflow-x:hidden}
button{font:inherit;cursor:pointer;border:0;color:inherit}
:focus-visible{outline:2px solid #8ab4ff;outline-offset:2px}

/* aurora tinted by current risk */
.aurora{position:fixed;inset:0;z-index:-1;overflow:hidden}
.aurora i{position:absolute;border-radius:50%;filter:blur(110px);opacity:.38;background:var(--lv);transition:background-color 1s}
.aurora i:nth-child(1){width:540px;height:540px;left:-120px;top:-160px}
.aurora i:nth-child(2){width:480px;height:480px;right:-100px;top:25%;background:#5b6cff;opacity:.25}
.aurora i:nth-child(3){width:520px;height:520px;left:35%;bottom:-260px}

header{max-width:1340px;margin:0 auto 22px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.brand{display:flex;gap:14px;align-items:center}
.logo{width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,#7c5cff,#38bdf8);display:grid;place-items:center;box-shadow:0 8px 28px rgba(124,92,255,.45)}
h1{font:800 30px var(--serif);letter-spacing:-.02em;line-height:1}
.sub{color:var(--mut);font-size:13px;margin-top:3px}
.tools{display:flex;gap:10px;align-items:center}
.live{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--mut);margin-right:6px}
.live::before{content:"";width:9px;height:9px;border-radius:50%;background:var(--lv);box-shadow:0 0 0 0 var(--lv);animation:pulse 2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 9px transparent}100%{box-shadow:0 0 0 0 transparent}}
.btn{background:var(--glass);border:1px solid var(--edge);padding:9px 18px;border-radius:99px;font-weight:700;font-size:13px;backdrop-filter:blur(10px);transition:transform .12s,background .2s}
.btn:hover{background:rgba(255,255,255,.12)}.btn:active{transform:scale(.97)}
.btn.main{background:linear-gradient(135deg,#7c5cff,#38bdf8);border-color:transparent;box-shadow:0 6px 22px rgba(90,110,255,.45)}

main{max-width:1340px;margin:0 auto;display:grid;grid-template-columns:1fr minmax(330px,390px) 1fr;gap:22px;align-items:start}
.glass{background:var(--glass);border:1px solid var(--edge);border-radius:28px;backdrop-filter:blur(18px);box-shadow:0 20px 60px rgba(0,0,0,.35)}

/* chat windows */
.phone{position:relative;height:640px;display:flex;flex-direction:column;overflow:hidden;transition:background .5s,border-color .5s}
.bar{display:flex;align-items:center;gap:12px;padding:16px 18px;border-bottom:1px solid var(--edge)}
.av{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font:800 17px var(--serif);color:#fff}
#harasser .av{background:linear-gradient(135deg,#ff8a3d,#f43f5e)}#victim .av{background:linear-gradient(135deg,#38bdf8,#6366f1)}
.bar b{font:800 18px var(--serif);display:block;line-height:1.1}.bar small{color:var(--mut);font-size:12px}
.role{margin-left:auto;font-size:11px;font-weight:700;padding:4px 10px;border-radius:99px;background:rgba(255,255,255,.08);color:var(--mut)}
.msgs{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:9px;scrollbar-width:thin}
.empty{margin:auto;color:var(--mut);text-align:center;font-size:13px;max-width:220px}
.m{max-width:78%;padding:10px 14px;border-radius:20px 20px 20px 5px;background:rgba(255,255,255,.1);align-self:flex-start;word-wrap:break-word;animation:in .25s ease-out}
.m.me{align-self:flex-end;border-radius:20px 20px 5px 20px;color:#fff}
#harasser .m.me{background:linear-gradient(135deg,#ff8a3d,#f43f5e)}
#victim .m.me{background:linear-gradient(135deg,#38bdf8,#6366f1)}
.m time{display:block;font-size:11px;opacity:.65;margin-top:2px}
.m .st{font-size:11px;font-weight:700;background:rgba(0,0,0,.3);display:inline-block;padding:1px 8px;border-radius:99px;margin-top:3px}
@keyframes in{from{transform:translateY(10px) scale(.96);opacity:0}to{transform:none;opacity:1}}
.chips{display:flex;gap:6px;padding:0 14px 8px;flex-wrap:wrap}
.chips button{font-size:12px;padding:4px 11px;border-radius:99px;background:rgba(255,255,255,.07);border:1px solid var(--edge);color:var(--mut)}
.chips button:hover{color:var(--text)}
.comp{display:flex;gap:8px;padding:12px 14px 16px}
.comp input{flex:1;min-width:0;border:1px solid var(--edge);background:rgba(0,0,0,.28);border-radius:99px;padding:11px 16px;font:inherit;color:var(--text)}
.comp input::placeholder{color:#74809e}.comp input:focus{outline:none;border-color:#8ab4ff}
.comp button{background:linear-gradient(135deg,#7c5cff,#38bdf8);font-weight:700;border-radius:99px;padding:0 20px}
.comp input:disabled,.comp button:disabled{opacity:.4;cursor:not-allowed}

.note{display:none;margin:12px 14px 0;padding:11px 14px;border-radius:14px;font-size:13px;font-weight:500}
.note.show{display:block;animation:in .3s}
.note.warn{background:rgba(251,191,36,.15);border:1px solid rgba(251,191,36,.6);color:#fde68a}
.note.lock{background:rgba(251,75,99,.15);border:1px solid rgba(251,75,99,.6);color:#fecdd3}

.modal{position:absolute;inset:0;background:rgba(4,7,16,.7);backdrop-filter:blur(5px);display:none;place-items:center;padding:22px;z-index:5}
.modal.show{display:grid}
.pop{background:#171c33;border:1px solid rgba(251,191,36,.6);border-radius:22px;padding:24px;text-align:center;max-width:330px;box-shadow:0 0 0 6px rgba(251,191,36,.1),0 24px 60px rgba(0,0,0,.6);animation:in .25s}
.pop h3{font:800 20px/1.2 var(--serif);margin-bottom:6px}.pop p{color:var(--mut);font-size:13px}
.pop q{display:block;background:rgba(0,0,0,.35);border-radius:12px;padding:9px 11px;margin:14px 0 18px;font-size:13px;quotes:none;word-break:break-word}
.pop .row{display:flex;gap:8px;justify-content:center}
.btn.go{background:var(--warn);color:#2b1d00;border-color:transparent}

#victim.blocked{background:rgba(251,75,99,.13);border-color:var(--danger);box-shadow:0 0 70px rgba(251,75,99,.35)}
.alert{position:absolute;inset:auto 0 0 0;display:none;flex-direction:column;gap:12px;align-items:flex-start;padding:22px;background:linear-gradient(135deg,#e11d48,#be123c);z-index:4}
#victim.blocked .alert{display:flex;animation:in .35s}
.alert strong{font:800 19px/1.25 var(--serif)}
.btn.white{background:#fff;color:#9f1239;border-color:#fff}

/* risk panel */
.risk{padding:24px;text-align:center}
.risk h2{font:600 14px var(--sans);color:var(--mut);text-align:left}
.gauge{position:relative;width:250px;height:250px;margin:6px auto 0}
.gauge svg{width:100%;height:100%;transform:rotate(135deg)}
.gauge circle{fill:none;stroke-width:16;stroke-linecap:round}
.g-track{stroke:rgba(255,255,255,.09);stroke-dasharray:424.1 565.5}
.g-fill{stroke:var(--lv);stroke-dasharray:0 565.5;transition:stroke-dasharray .7s cubic-bezier(.3,.9,.3,1),stroke .6s;filter:drop-shadow(0 0 10px var(--lv))}
.gauge .c{position:absolute;inset:0;display:grid;place-content:center;gap:2px}
.gauge b{font:800 84px/1 var(--serif);letter-spacing:-.04em;color:var(--lv);transition:color .6s}
.gauge span{color:var(--mut);font-size:13px}
.level{display:inline-block;margin-top:-30px;font-weight:700;font-size:14px;padding:5px 16px;border-radius:99px;background:var(--lv);color:#10151f;position:relative;transition:background .6s}
.verdict{margin:14px 6px 16px;font-size:14.5px;min-height:42px}
.zones{display:flex;height:6px;border-radius:9px;overflow:hidden;margin:0 6px}
.zones i{height:100%}.zones i:nth-child(1){width:30%;background:var(--safe)}.zones i:nth-child(2){width:30%;background:var(--warn)}.zones i:nth-child(3){width:40%;background:var(--danger)}
.zlab{display:flex;font-size:11px;color:var(--mut);margin:5px 6px 0}.zlab span:nth-child(1){width:30%;text-align:left}.zlab span:nth-child(2){width:30%}.zlab span:nth-child(3){width:40%;text-align:right}
h3.sec{font:800 15px var(--serif);margin:22px 0 10px;text-align:left}
.hist{height:70px;display:flex;align-items:flex-end;gap:5px;border-bottom:1px solid var(--edge)}
.hist i{flex:1;max-width:28px;min-height:4px;border-radius:7px 7px 0 0;background:var(--safe);transition:height .5s}
.hist i.w{background:var(--warn)}.hist i.d{background:var(--danger);box-shadow:0 0 12px rgba(251,75,99,.6)}
.hist i.r{background:transparent;border:1.5px dashed var(--mut);border-bottom:0}
.hint{color:var(--mut);font-size:12px;margin-top:6px;text-align:left}
ul.why{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:7px}
ul.why li{background:rgba(255,255,255,.09);border-radius:99px;padding:5px 13px;font-size:13px;font-weight:500;animation:in .25s}
ul.why li.d{background:rgba(251,75,99,.2);color:#fecdd3}ul.why li.n{color:var(--mut);background:none;padding-left:0}
.stats{display:flex;gap:10px;margin-top:20px}
.stats div{flex:1;border:1px solid var(--edge);border-radius:16px;padding:10px 12px;text-align:left;background:rgba(255,255,255,.04)}
.stats b{font:800 24px var(--serif);display:block}.stats span{font-size:12px;color:var(--mut)}

@media(max-width:1040px){main{grid-template-columns:1fr}.risk{order:-1}.phone{height:540px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body class="lvl-safe">
<div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>

<header>
  <div class="brand">
    <div class="logo" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6z"/><path d="M8.5 12.2l2.4 2.4 4.6-4.8"/></svg></div>
    <div><h1>Sentinel</h1><div class="sub">Reads the pattern between two people, not just the words</div></div>
  </div>
  <div class="tools"><span class="live">Sentinel is watching</span><button class="btn main" id="demo">Play demo</button><button class="btn" id="reset">Reset</button></div>
</header>

<main>
  <section class="glass phone" id="harasser" aria-label="Harasser chat">
    <div class="bar"><div class="av">H</div><div><b>Harasser</b><small id="hstat">Online</small></div><span class="role">Sender</span></div>
    <div class="note lock" id="hlock">🚫 You have been blocked from messaging this person.</div>
    <div class="msgs" id="hmsgs"><div class="empty">Write as the sender. Sentinel scores each message before it is delivered.</div></div>
    <div class="chips" id="chips"><button>hey, how are you?</button><button>answer me</button><button>I'm outside your building</button><button>you will pay for this</button></div>
    <form class="comp" id="hform" autocomplete="off"><input id="hin" placeholder="Message as Harasser…" aria-label="Harasser message"><button id="hsend">Send</button></form>
    <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="mt">
      <div class="pop">
        <h3 id="mt">⚠️ Are you sure you want to send this?</h3>
        <p>Sentinel flagged this message as possible harassment.</p>
        <q id="mq"></q>
        <div class="row"><button class="btn" id="mcancel">Edit message</button><button class="btn go" id="msend">Send anyway</button></div>
      </div>
    </div>
  </section>

  <aside class="glass risk" id="risk" aria-live="polite">
    <h2>Risk score for this conversation</h2>
    <div class="gauge">
      <svg viewBox="0 0 220 220"><circle class="g-track" cx="110" cy="110" r="90"/><circle class="g-fill" id="gfill" cx="110" cy="110" r="90"/></svg>
      <div class="c"><b id="num">0</b><span>out of 100</span></div>
    </div>
    <span class="level" id="level">Low risk</span>
    <p class="verdict" id="verdict">The conversation looks normal. No action needed.</p>
    <div class="zones"><i></i><i></i><i></i></div>
    <div class="zlab"><span>Below 30 · green</span><span>30–60 · yellow</span><span>Above 60 · red</span></div>
    <h3 class="sec">Risk after each message</h3>
    <div class="hist" id="hist"></div>
    <div class="hint">Dashed bars are replies from the victim.</div>
    <h3 class="sec">What Sentinel noticed</h3>
    <ul class="why" id="why"><li class="n">Nothing concerning yet.</li></ul>
    <div class="stats"><div><b id="sSent">0</b><span>Messages sent</span></div><div><b id="sUn">0</b><span>Unanswered in a row</span></div></div>
  </aside>

  <section class="glass phone" id="victim" aria-label="Victim chat">
    <div class="bar"><div class="av">V</div><div><b>Victim</b><small id="vstat">Online</small></div><span class="role">Recipient</span></div>
    <div class="note warn" id="vwarn" role="alert">⚠️ Sentinel noticed a worrying pattern in these messages. You don’t have to reply.</div>
    <div class="msgs" id="vmsgs"><div class="empty">Messages from the sender show up here.</div></div>
    <form class="comp" id="vform" autocomplete="off"><input id="vin" placeholder="Reply as Victim…" aria-label="Victim reply"><button>Reply</button></form>
    <div class="alert" role="alert"><strong>🚨 Harassment pattern detected. Evidence saved.</strong><button class="btn white" id="dl">Download evidence report</button></div>
  </section>
</main>

<script>
const $ = s => document.querySelector(s);
const API_URL = ""; // optional: your FastAPI endpoint, e.g. "http://localhost:8000/analyze"
const S = {log:[], hist:[], risk:0, unanswered:0, sent:0, tox:[], blocked:false, pending:null, busy:false, run:0};

/* Analyzer: uses your backend if API_URL is set, otherwise a local mock of pattern scoring */
const LEX = [
  [.95,/\b(kill|hurt you|make you pay|you will pay|know where you live|find you|burn)\b/i,"Threatening language"],
  [.85,/\b(nudes?|send pics?|naked|sexy pics?)\b/i,"Sexual harassment"],
  [.6,/\b(ugly|stupid|worthless|freak|loser|idiot|hate you|disgusting|pathetic)\b/i,"Insults"],
  [.55,/\b(watching you|i'?m outside|following you|saw you at|where are you|answer me|pick up)\b/i,"Stalking language"],
  [.25,/\b(why aren'?t you|reply|ignoring me|talk to me)\b/i,"Pressure to reply"]
];
async function analyze(text){
  if (API_URL){
    try{ const r = await fetch(API_URL,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({text,history:S.log})}); return await r.json(); }
    catch(e){ console.warn("API failed, using mock",e); }
  }
  let tox = 0, why = [];
  for (const [w,re,l] of LEX) if (re.test(text)){ tox = Math.max(tox,w); why.push(l); }
  if (text.length>6 && text===text.toUpperCase() && /[A-Z]/.test(text)){ tox = Math.min(1,tox+.15); why.push("Shouting"); }
  if (/[!?]{2,}/.test(text)) tox = Math.min(1,tox+.1);
  const u = S.unanswered+1, p = S.tox.slice(-3);
  const esc = p.length>=2 && tox>.5 && tox>p.reduce((a,b)=>a+b,0)/p.length+.15;
  if (u>=3) why.push(u+" messages with no reply");
  if (esc) why.push("Tone is escalating");
  const risk = Math.min(100, Math.round(S.risk*.8 + (tox*55 + Math.min(u,10)*3 + (esc?8:0))*.7));
  return {risk, action: risk>=75?"block":risk>=30?"warn":"allow", reasons:why, tox};
}

const hhmm = () => new Date().toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"});
function addMsg(box,text,mine,note){
  const el=$(box); el.querySelector(".empty")?.remove();
  const d=document.createElement("div"); d.className="m"+(mine?" me":"");
  const t=document.createElement("span"); t.textContent=text; d.append(t);
  if(note){const n=document.createElement("div"); n.className="st"; n.textContent=note; d.append(n);}
  const ti=document.createElement("time"); ti.textContent=hhmm(); d.append(ti);
  el.append(d); el.scrollTop=el.scrollHeight;
}
function render(reasons){
  const r=S.risk, lvl=r>60?"danger":r>=30?"warn":"safe";
  document.body.className="lvl-"+lvl;
  $("#num").textContent=r; $("#gfill").style.strokeDasharray=(424.1*r/100)+" 565.5";
  $("#level").textContent = S.blocked?"Blocked":lvl==="safe"?"Low risk":lvl==="warn"?"Elevated risk":"High risk";
  $("#verdict").textContent = S.blocked ? "Sender blocked. The message history has been saved as evidence."
    : lvl==="safe" ? "The conversation looks normal. No action needed."
    : lvl==="warn" ? "A pattern is building. The sender is warned before each message."
    : "One more message like this will trigger a block.";
  $("#hist").innerHTML = S.hist.map(h=>`<i class="${h.reply?"r":h.v>60?"d":h.v>=30?"w":""}" style="height:${Math.max(h.v,4)}%"></i>`).join("");
  $("#sSent").textContent=S.sent; $("#sUn").textContent=S.unanswered;
  const ul=$("#why"); ul.innerHTML="";
  (reasons.length?reasons:["Nothing concerning yet."]).forEach(x=>{const li=document.createElement("li"); li.textContent=x; li.className=reasons.length?(lvl==="danger"?"d":""):"n"; ul.append(li);});
}

async function submitHarasser(text,auto){
  if (S.blocked||S.busy||!text.trim()) return;
  S.busy=true; const res=await analyze(text);
  if (res.action==="warn"){
    S.pending={text,res}; $("#mq").textContent=text; $("#modal").classList.add("show"); $("#msend").focus();
    if(auto){ await new Promise(r=>setTimeout(r,1500)); if(S.pending) $("#msend").click(); }
    S.busy=false; return;
  }
  deliver(text,res); S.busy=false;
}
function deliver(text,res){
  S.sent++; S.risk=res.risk; S.tox.push(res.tox??0); S.hist.push({v:res.risk});
  S.log.push({from:"harasser",text,risk:res.risk,time:new Date().toISOString(),reasons:res.reasons});
  if (res.action==="block"){
    S.blocked=true; addMsg("#hmsgs",text,true,"Not delivered · blocked");
    $("#victim").classList.add("blocked"); $("#vwarn").classList.remove("show");
    $("#hlock").classList.add("show"); $("#hin").disabled=$("#hsend").disabled=true;
    $("#hstat").textContent="Blocked"; $("#vstat").textContent="Protected by Sentinel";
  } else {
    S.unanswered++; addMsg("#hmsgs",text,true); addMsg("#vmsgs",text,false);
    $("#vwarn").classList.toggle("show",res.action==="warn");
  }
  render(res.reasons);
}
$("#hform").onsubmit=e=>{e.preventDefault(); const v=$("#hin").value; $("#hin").value=""; submitHarasser(v);};
$("#chips").onclick=e=>{ if(e.target.tagName==="BUTTON") submitHarasser(e.target.textContent); };
$("#msend").onclick=()=>{ if(!S.pending) return; $("#modal").classList.remove("show"); const {text,res}=S.pending; S.pending=null; deliver(text,res); };
$("#mcancel").onclick=()=>{ $("#modal").classList.remove("show"); $("#hin").value=S.pending?.text||""; S.pending=null; $("#hin").focus(); };

$("#vform").onsubmit=e=>{
  e.preventDefault(); const v=$("#vin").value.trim(); if(!v) return; $("#vin").value="";
  addMsg("#vmsgs",v,true); addMsg("#hmsgs",v,false);
  S.log.push({from:"victim",text:v,time:new Date().toISOString()});
  S.unanswered=0; S.risk=Math.round(S.risk*.85); S.hist.push({v:S.risk,reply:true});
  render(S.risk>=30?["Risk eases after a reply"]:[]);
};

$("#dl").onclick=()=>{
  const L=["SENTINEL EVIDENCE REPORT","Generated: "+new Date().toLocaleString(),"Final risk score: "+S.risk,"","Message log:"];
  S.log.forEach(m=>L.push(`[${m.time}] ${m.from}: ${m.text}`+(m.risk!=null?`  (risk ${m.risk}${m.reasons?.length?"; "+m.reasons.join(", "):""})`:"")));
  const a=document.createElement("a"); a.href=URL.createObjectURL(new Blob([L.join("\n")],{type:"text/plain"})); a.download="sentinel-evidence-report.txt"; a.click();
};

function reset(){
  S.run++; Object.assign(S,{log:[],hist:[],risk:0,unanswered:0,sent:0,tox:[],blocked:false,pending:null,busy:false});
  $("#hmsgs").innerHTML='<div class="empty">Write as the sender. Sentinel scores each message before it is delivered.</div>';
  $("#vmsgs").innerHTML='<div class="empty">Messages from the sender show up here.</div>';
  $("#victim").classList.remove("blocked"); $("#vwarn").classList.remove("show"); $("#modal").classList.remove("show"); $("#hlock").classList.remove("show");
  $("#hin").disabled=$("#hsend").disabled=false; $("#hstat").textContent=$("#vstat").textContent="Online";
  render([]);
}
$("#reset").onclick=reset;
$("#demo").onclick=async()=>{
  reset(); const run=S.run;
  const script=["hey, how was your day?","why aren't you replying?","answer me","I saw you at the station today","WHY ARE YOU IGNORING ME??","I'm outside your building. I know where you live","you will pay for ignoring me"];
  for (const m of script){
    if (S.run!==run||S.blocked) break;
    $("#hin").value=m; await new Promise(r=>setTimeout(r,700)); if(S.run!==run) break; $("#hin").value="";
    await submitHarasser(m,true); await new Promise(r=>setTimeout(r,2200));
  }
};
render([]);
</script>
</body>
</html>


